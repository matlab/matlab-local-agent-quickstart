{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:1234/v1"
      },
      "models": {
        "local-coder": {
          "name": "Local coder model served by LM Studio"
        }
      }
    }
  },
  "model": "lmstudio/local-coder",
  "mcp": {
    "matlab": {
      "type": "local",
      "command": ["C:\\Users\\yourname\\.matlab\\agentic-toolkits\\bin\\matlab-mcp-server-windows-x64.exe", "--disable-telemetry=true"],
      "enabled": true
    }
  }
}
